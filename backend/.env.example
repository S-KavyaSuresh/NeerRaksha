DATABASE_URL=
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OBSERVATION branch (Sentinel-1 via Google Earth Engine), optional.
# 1. pip install -r requirements.txt (installs earthengine-api)
# 2. earthengine authenticate --force   (stores a user credential outside this repo)
# 3. earthengine set_project <your-gcp-project-id>
# 4. set the same project id below — this is the only OBSERVATION-branch value
#    that belongs in .env; never put OAuth tokens or key files here.
# EARTHENGINE_PROJECT=your-gcp-project-id
